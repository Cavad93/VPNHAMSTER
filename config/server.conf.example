# VPN Tunnel Server Configuration Example
# Copy this file to server.conf and edit as needed

[server]
# IP address to bind to (0.0.0.0 for all interfaces)
host = 0.0.0.0

# TCP port to listen on
port = 8888

# TUN interface IP address
tun_ip = 10.8.0.1

[encryption]
# Encryption key (hex string)
# Generate with: python3 scripts/generate_key.py
key = YOUR_ENCRYPTION_KEY_HERE
